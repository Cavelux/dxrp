@namespace LifePunch.DXRP.Addons
@using Sandbox
@using Sandbox.UI
@inherits Panel
@attribute [StyleSheet]

<root class="lp-source-footer">
    <span class="lp-mark">@LifePunchSourceMark.UiFooterMark</span>
    <button class="lp-url-copy @(_urlCopied ? "copied" : "")"
            tooltip="@($"Copy {LifePunchSourceMark.UiFooterUrl}")"
            onclick="@CopySourceUrl">
        @( _urlCopied ? "Link copied!" : LifePunchSourceMark.UiFooterUrl )
    </button>
</root>

@code {
    private bool _urlCopied;

    private void CopySourceUrl()
    {
        Clipboard.SetText( LifePunchSourceMark.UiFooterUrl );
        _urlCopied = true;
        StateHasChanged();
        _ = RevertCopyLabel();
    }

    private async System.Threading.Tasks.Task RevertCopyLabel()
    {
        await GameTask.DelayRealtimeSeconds( 1.8f );
        _urlCopied = false;
        StateHasChanged();
    }
}
